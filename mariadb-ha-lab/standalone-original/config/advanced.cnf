[mariadb]
# Learning-oriented settings. Do not copy blindly to production.
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

# Query / lock observability
performance_schema=ON
slow_query_log=ON
slow_query_log_file=/var/lib/mysql/slow.log
long_query_time=0.2
log_queries_not_using_indexes=ON
innodb_print_all_deadlocks=ON

# Binlog practice
server_id=1
log_bin=mysql-bin
binlog_format=ROW
binlog_expire_logs_seconds=259200

# Make the lab large enough for realistic concurrency practice.
max_connections=200

[client]
default-character-set=utf8mb4
