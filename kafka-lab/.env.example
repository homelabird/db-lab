# 로컬 Linux Podman 실습 전용. 인증/TLS 없음: 인터넷에 노출하지 마세요.
# 컨테이너 엔진: auto(설치된 경우 중 podman 우선) | podman | docker.
# docker를 쓰려면 CONTAINER_ENGINE=docker 로 설정하세요.
CONTAINER_ENGINE=auto
LAB_NAME=kzk-lab
# zk 또는 kraft. 모드마다 별도 데이터 volume을 사용합니다.
KAFKA_MODE=zk
# Kafka/ZooKeeper node count. ZooKeeper requires an odd count (1,3,5,...) for quorum.
NODES=3
# 현재 검증된 CP 버전. latest / 8.x로 변경하지 마세요.
CP_VERSION=7.9.0
# KRaft 최초 실행 시 lab.sh가 자동 생성·보존합니다. 직접 지정해도 됩니다.
# KRAFT_CLUSTER_ID=
# 원격 PC 접속 시 BIND_IP=0.0.0.0, ADVERTISED_HOST=실제_서버_IP 로 변경.
BIND_IP=127.0.0.1
ADVERTISED_HOST=localhost
KAFKA1_PORT=19092
KAFKA2_PORT=29092
KAFKA3_PORT=39092
UI_PORT=8088
UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.3.0
KAFKA_HEAP_OPTS="-Xms256m -Xmx512m"
ZOOKEEPER_HEAP_OPTS="-Xms128m -Xmx256m"
STARTUP_TIMEOUT=240
