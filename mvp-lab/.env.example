# Run ./lab.sh init; it generates the four GENERATE values, preserving existing .env.
# These resources are independent of the four existing HA labs.
MVP_PROJECT=db-lab-mvp
MVP_ENGINE=auto
API_PORT=18090
MARIADB_IMAGE=docker.io/library/mariadb:11.8
KAFKA_IMAGE=docker.io/confluentinc/cp-kafka:7.9.0
# Deliberately matches the legacy ES lab. Isolated learning ONLY, not supported production.
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:7.17.29
REDIS_IMAGE=docker.io/library/redis:7.4.11-alpine
SQL_ROOT_PASSWORD=GENERATE
SQL_PASSWORD=GENERATE
REDIS_PASSWORD=GENERATE
KRAFT_CLUSTER_ID=GENERATE
CACHE_TTL=30
