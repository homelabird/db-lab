FROM docker.io/library/python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --create-home lab
COPY mvp_app /app/mvp_app
COPY Containerfile /app/Containerfile
RUN python -m mvp_app.runtime_contract seal
USER 10001:10001
EXPOSE 8080
CMD ["python", "-m", "mvp_app.api"]
