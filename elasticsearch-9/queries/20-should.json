{
  "size": 10,
  "track_total_hits": true,
  "_source": {
    "excludes": [
      "payload"
    ]
  },
  "query": {
    "bool": {
      "filter": [
        {
          "term": {
            "channel": "APP"
          }
        }
      ],
      "should": [
        {
          "term": {
            "is_fraud": true
          }
        },
        {
          "range": {
            "amount": {
              "gte": 1000000
            }
          }
        }
      ],
      "minimum_should_match": 1
    }
  }
}
