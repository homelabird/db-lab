{
  "dynamic": "strict",
  "properties": {
    "@timestamp": {
      "type": "date"
    },
    "document_id": {
      "type": "keyword"
    },
    "event_seq": {
      "type": "long"
    },
    "user_id": {
      "type": "keyword"
    },
    "trace_id": {
      "type": "keyword"
    },
    "src_ip": {
      "type": "ip"
    },
    "tags": {
      "type": "keyword"
    },
    "scenario": {
      "type": "keyword"
    },
    "message": {
      "type": "text",
      "analyzer": "standard",
      "fields": {
        "keyword": {
          "type": "keyword",
          "ignore_above": 256
        }
      }
    },
    "payload": {
      "type": "keyword",
      "index": false,
      "doc_values": false
    },
    "error_code": {
      "type": "keyword"
    },
    "request_id": {
      "type": "keyword"
    },
    "method": {
      "type": "keyword"
    },
    "path": {
      "type": "keyword"
    },
    "endpoint": {
      "type": "keyword"
    },
    "user_agent": {
      "type": "keyword"
    },
    "device_type": {
      "type": "keyword"
    },
    "cache_hit": {
      "type": "boolean"
    },
    "referer": {
      "type": "keyword"
    },
    "protocol": {
      "type": "keyword"
    },
    "session_id": {
      "type": "keyword"
    },
    "service": {
      "type": "keyword"
    },
    "status": {
      "type": "integer"
    },
    "latency_ms": {
      "type": "integer"
    },
    "bytes": {
      "type": "long"
    }
  }
}
