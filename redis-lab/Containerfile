ARG REDIS_IMAGE=docker.io/library/redis:7.4.11-alpine
ARG PYTHON_IMAGE=docker.io/library/python:3.12-slim-bookworm
FROM ${REDIS_IMAGE} AS redis-node
COPY config/ /opt/lab/config/
COPY container/entrypoint.sh /usr/local/bin/lab-entrypoint.sh
RUN chmod 755 /usr/local/bin/lab-entrypoint.sh
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/lab-entrypoint.sh"]

FROM ${PYTHON_IMAGE} AS client
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY client/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt     && useradd --uid 10001 --create-home lab     && mkdir -p /results && chown lab:lab /results
COPY client/ /app/
USER 10001:10001
CMD ["python", "client.py", "idle"]
