ARG REDIS_IMAGE=docker.io/library/redis:7.4.11-alpine
ARG PYTHON_IMAGE=docker.io/library/python:3.12-slim-bookworm
FROM ${REDIS_IMAGE} AS perf
COPY container/perf-start.sh /usr/local/bin/perf-start.sh
RUN chmod 755 /usr/local/bin/perf-start.sh
ENTRYPOINT ["/usr/local/bin/perf-start.sh"]

FROM ${PYTHON_IMAGE} AS runner
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN useradd --uid 10001 --create-home lab && mkdir -p /results/ops && chown -R lab:lab /results
COPY ops/ /app/ops/
USER 10001:10001
CMD ["python", "-m", "ops.cli", "idle"]
