# lab.sh init creates .env and replaces these two demo passwords with random values.
# Do not change passwords or addresses after creating volumes. See docs/06-operations.md.
LAB_NAME=rslab
REDIS_IMAGE=docker.io/library/redis:7.4.11-alpine
PYTHON_IMAGE=docker.io/library/python:3.12-slim-bookworm
REDIS_PASSWORD=CHANGE_ME_REDIS_123
SENTINEL_PASSWORD=CHANGE_ME_SENTINEL_123
MASTER_NAME=mymaster
LAB_SUBNET=10.89.77.0/24
REDIS_1_IP=10.89.77.11
REDIS_2_IP=10.89.77.12
REDIS_3_IP=10.89.77.13
SENTINEL_1_IP=10.89.77.21
SENTINEL_2_IP=10.89.77.22
SENTINEL_3_IP=10.89.77.23
CLIENT_IP=10.89.77.30
SANDBOX_IP=10.89.77.40
REDIS_MAXMEMORY=192mb
REDIS_CONTAINER_MEMORY=512m
SENTINEL_CONTAINER_MEMORY=128m
CLIENT_CONTAINER_MEMORY=192m
DOWN_AFTER_MS=5000
FAILOVER_TIMEOUT_MS=30000
