# Copy to .env. KEY=value only; do not use shell commands or inline comments.
COMPOSE_PROJECT_NAME=cerebro-seed-lab
# Change together with COMPOSE_PROJECT_NAME when running another copy of this lab.
LAB_CONTAINER_PREFIX=cerebro-seed-
COMPOSE_PROVIDER=auto
LAB_CLUSTER_NAME=cerebro-shard-lab
# Client URL used by scripts running ON the lab host; not a listen address.
ES_URL=http://127.0.0.1:9200
# Legacy, unauthenticated lab: local access only by default.
# Remote access requires an isolated network AND ES_ALLOW_PUBLIC_BIND=yes.
ES_BIND_IP=127.0.0.1
ES_ALLOW_PUBLIC_BIND=no
ES_PORT=9200
CEREBRO_PORT=9000
KIBANA_PORT=5601
KIBANA_STACK_MONITORING_ENABLED=true
KIBANA_STACK_MANAGEMENT_ENABLED=true
ES_HEAP=640m

# X-Pack Security (opt-in; default keeps the legacy unauthenticated lab).
# Set XPACK_SECURITY_ENABLED=true and all passwords below for Basic auth on
# Elasticsearch, Kibana, and ./lab.sh requests. Cerebro is skipped in this mode.
# Note: with security enabled, Elasticsearch 7 also requires transport TLS
# (xpack.security.transport.ssl.*); see README before enabling.
XPACK_SECURITY_ENABLED=false
ELASTIC_USERNAME=elastic
# ELASTIC_PASSWORD=set-me-when-enabled
KIBANA_USERNAME=kibana_system
# Set this to the password assigned to the built-in kibana_system user.
# KIBANA_PASSWORD=set-kibana-system-password
# Kibana UI login created by ./lab.sh up when XPACK_SECURITY_ENABLED=true.
# KIBANA_LOGIN_USERNAME=lab-admin
# KIBANA_LOGIN_PASSWORD=set-a-strong-login-password

# Shared filesystem snapshot repository, created and verified by ./lab.sh up.
# All 5 nodes mount the shared es-snapshots volume at this path.
SNAPSHOT_REPO_NAME=lab-snapshots
SNAPSHOT_PATH=/usr/share/elasticsearch/snapshots

SEED_SIZE_MB=100
SEED=42
SEED_START_DATE=2026-08-01T00:00:00Z
BULK_SIZE=500
WAIT_SECONDS=300
# Startup polling deadlines (seconds).
CONTAINER_WAIT_SECONDS=90
KIBANA_WAIT_SECONDS=180
CEREBRO_WAIT_SECONDS=120

# Per-stage polling deadline for managed fault drills (seconds).
FAULT_TIMEOUT=180
